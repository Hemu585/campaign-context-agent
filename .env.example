# Local, non-secret settings for the Campaign Context Agent.
# Copy to .env only if you need to change something. There are deliberately
# no API-key fields: the app never calls a paid or cloud service.

APP_ENV=local
DEMO_MODE=true
DEMO_AS_OF=2026-10-15T12:00:00Z

# FalkorDB (Docker, loopback only). Pinned by digest; see compose.yaml.
FALKORDB_IMAGE=falkordb/falkordb:v4.22.1@sha256:b0bdcac2cbaff989e77cb0610439b7a9289e86de033ccbbd4368b66fb680ae7a
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH=campaign_context_demo

# Ollama on the host (loopback only; cloud models are refused by the backend).
# The Ollama *server* itself needs OLLAMA_NO_CLOUD=1 and OLLAMA_KV_CACHE_TYPE=q8_0
# in its own environment (user env vars, then restart Ollama); this file does not
# configure an already-running Ollama process.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512
OLLAMA_SEED=42

ALLOWED_ORIGINS=http://127.0.0.1:5173
AGENT_MAX_TURNS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_RUN_TIMEOUT_SECONDS=180
